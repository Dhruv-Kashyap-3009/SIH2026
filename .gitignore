# Raw data (too large for GitHub - download separately)
data/raw/

# Processed data (large CSVs regenerated by scripts)
data/processed/*.csv
data/processed/*.png

# Full-state/bulk JSON exports (40+ MB; regenerated by generate_vyoma_export.py /
# generate_relocation_sites.py — only the small Mizoram sample JSONs are tracked)
data/processed/vyoma_export_all_states.json
data/processed/vyoma_sites_export_all_states.json
data/processed/relocation_sites.json

# Versioned static read bundles for the VYOMA UI (generated by
# scripts/generate_frontend_static.py)
data/processed/static/

# Model artifacts (large, regenerated by training)
models/*.json
models/*.png

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Node / VYOMA frontend (React + Vite) and backend (Express + Prisma)
node_modules/
frontend/dist/
backend/dist/
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
backend/prisma/migrations/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temp
*.tmp
*.bak
