# VYOMA backend — environment template.
# Copy this file to `.env` and replace the placeholder with your real values:
#   cp .env.example .env
#
# PostgreSQL connection string (required). Free tier: https://neon.tech
# Pick a region close to your users — e.g. Singapore (ap-southeast-1) cuts
# cold-query latency roughly 4x vs US-East for this dataset.
#
# Neon example:
#   postgresql://neondb_owner:XXXX@ep-YYYY.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://user:password@localhost:5432/vyoma?sslmode=require"

# REQUIRED IN PRODUCTION — secret used to sign login session tokens
# (src/lib/auth.ts). The server refuses to start with NODE_ENV=production until
# this is a unique random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A dev-only fallback is used when unset outside production (backend/.env
# currently has no AUTH_SECRET, so development uses that fallback).
# AUTH_SECRET="replace-with-a-long-random-string"

# Optional overrides used by the seed script (npm run seed):
#   SEED_DATA_DIR            — directory holding the two export JSONs (default: ../../data/processed)
#   SEED_VILLAGES_FILE       — villages filename (default vyoma_export_all_states.json)
#   SEED_SITES_FILE          — sites filename (default vyoma_sites_export_all_states.json)
# Example — seed the bundled Mizoram demo fixture instead of the full dataset:
#   SEED_VILLAGES_FILE=vyoma_export_mizoram.json SEED_SITES_FILE=vyoma_sites_export_mizoram.json npm run seed

# Optional login rate limiting (routes/auth.ts, in-memory fixed window):
#   LOGIN_RATE_MAX_ATTEMPTS — failed attempts allowed per email+IP per window (default 10)
#   LOGIN_RATE_WINDOW_MS    — window length in ms (default 900000 = 15 min)
